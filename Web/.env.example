NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only secret. Never expose this to browser or mobile clients.
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

FACE_API_URL=https://your-face-api-host.example.com
# Server-to-server token. Keep this out of the mobile app and source control.
FACE_API_TOKEN=replace_with_a_random_32_byte_or_longer_secret
