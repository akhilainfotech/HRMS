{
  "expo": {
    "name": "HRMS Attendance",
    "slug": "hrms-attendance",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.peopleops.hrmsattendance",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HRMS to take an attendance selfie.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HRMS to check your location when recording attendance."
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "fcf5af00-c489-4f73-9d48-85f2c9d5bcc9"
      }
    },
    "owner": "akhilainfotech"
  }
}
